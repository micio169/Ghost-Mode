<Window x:Class="GhostMode.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GHOST MODE" Height="480" Width="360"
        WindowStyle="ToolWindow" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0B0C10" Offset="0.0"/>
            <GradientStop Color="#1F2833" Offset="1.0"/>
        </LinearGradientBrush>
    </Window.Background>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <TextBlock Foreground="#66FCF1" FontSize="14" FontWeight="Bold" 
                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,30,0,0"><Run Language="ko-kr" Text="GHOST MODE"/><LineBreak/><Run Language="ko-kr"/></TextBlock>

        <TextBlock x:Name="TxtStatus" Text="ONLINE" 
                   Foreground="#45A29E" FontSize="36" FontWeight="Black" 
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,30" />

        <Button x:Name="BtnGhostToggle" Grid.Row="1" Width="160" Height="160" 
                Click="BtnGhostToggle_Click" Cursor="Hand"
                HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,20">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder" CornerRadius="80" Background="#121212" 
                            BorderBrush="#45A29E" BorderThickness="3">
                        <Border.Effect>
                            <DropShadowEffect x:Name="GlowEffect" Color="#45A29E" BlurRadius="25" ShadowDepth="0" Opacity="0.8"/>
                        </Border.Effect>
                        <TextBlock x:Name="BtnText" Text="CHANGE" Foreground="#E0E0E0" FontSize="22" 
                                   FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#1A1A1A"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/>
                            <Setter TargetName="BtnText" Property="Text" Value="WAIT..."/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Border Grid.Row="2" Background="#000000" Opacity="0.6">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse x:Name="ClientStatusDot" Width="12" Height="12" Fill="Red" Margin="0,0,10,0"/>
                <TextBlock x:Name="TxtClientStatus" Text="League Client : Not Detected" 
                           Foreground="#C5C6C7" FontSize="13" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>